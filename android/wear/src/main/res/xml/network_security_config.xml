<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted here only because this file cannot express address ranges. The
     real policy is enforced in code: HttpUsageSource refuses to connect unless
     cleartextAllowed(url) in :shared (UrlPolicy.kt) passes, which allows plain http only to
     private, loopback, and Tailscale addresses and https everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
